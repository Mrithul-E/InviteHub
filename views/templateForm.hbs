<div class="container">
    <div class="row justify-content-center pt-3">
        <div class="col-md-6">
            <form id="templateForm" enctype="multipart/form-data">
                <div id="renderArea"></div>

                <div id="formError" class="alert alert-danger d-none mt-3" role="alert"></div>
                <div id="formSuccess" class="alert alert-success d-none mt-3" role="alert"></div>

                <div class="alert alert-light d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle-fill opacity-50 me-2"></i>
                    <div>
                        All invitations get deleted after 1 year.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">
                    Submit
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var formData = {{{templatesData}}};
        const formError = $("#formError")
        const formSuccess = $("#formSuccess")
        const templateId = formData[0].id

        console.log(formData)

        if (formData[0].formHBS) {
            $("#renderArea").html(formData[0].formHBS)
        } else if (formData[0].fieldsData.length !== 0) {
            $("#renderArea").formRender({
                dataType: 'json',
                formData: formData[0].fieldsData
            });
        }

        $("#templateForm").on("submit", function (e) {
            e.preventDefault()
            const form = this

            formError.addClass("d-none").text("")
            formSuccess.addClass("d-none").text("")

            const maxFileSize = 50 * 1024 * 1024 // 50 MB in bytes
            let totalFileSize = 0

            $(form).find('input[type="file"]').each(function () {
                for (const file of this.files) {
                    totalFileSize += file.size
                }
            })

            console.log("Total file size: ", (totalFileSize/1024/1024), " MB");

            if (totalFileSize > maxFileSize) {
                formError
                    .removeClass("d-none")
                    .html(
                        `<strong>File upload error:</strong> The total size of all uploaded files must not exceed ${maxFileSize/1024/1024} MB. </br>` +
                        `Your total file size: ${(totalFileSize/1024/1024).toFixed(2)} MB`
                    )

                $("html, body").animate({
                    scrollTop: formError.offset().top - 100
                }, 300)

                return;
            }

            formSuccess
                .removeClass("d-none")
                .html(`
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                `)

            const data = new FormData(form)
            data.append("templateId", templateId)


            $.ajax({
                url: "/templates/invitationData",
                type: "POST",
                data: data,
                processData: false,
                contentType: false,
                success: function (response) {
                    console.log("Submission successful:", response);
                    formSuccess.removeClass("d-none").html(`
                        <div class="d-flex justify-content-between align-items-center gap-">
                            <a href="${response.url}" id="invitationLink" target="_blank">Invitation link</a>
                            <button type="button" id="copyBtn" class="btn btn-outline-success btn-sm ">
                                Copy
                            </button>
                        </div>
                    `)
                    // form.reset();
                },
                error: function (xhr) {
                    formSuccess.addClass("d-none").text("")
                    console.error("Submission failed:", xhr);
                    let message = xhr.responseJSON?.message || "Form submission failed.";

                    formError.removeClass("d-none").text(message);

                    $("html, body").animate({
                        scrollTop: formError.offset().top - 100
                    }, 300);
                }
            });

        });

        $("#copyBtn").on('click', async function () {
            const url = $("#invitationLink").attr('href')
            await navigator.clipboard.writeText(url)

            $(this).text("Copied!")
            setInterval(()=>{
                $(this).text("copy")
            }, 1500)
        })

    });
</script>