<div class="container-fluid pt-3">
  <div class="row d-flex justify-content-center align-items-center">
    <div class="col-12 col-md-4 mb-3">
      <input type="search" name="" id="templateSearch" placeholder="Search templates" autocomplete="off" class="w-100">
    </div>
  </div>

  <div class="row g-2">
    {{#if adminLoggedIn}}
    <div class="col-6 col-md-4 col-lg-2">
      <div class="templates-card d-flex justify-content-center align-items-center flex-column" id="createTemplate">
        <i class="bi bi-plus"></i>
        <h3 class="">Create template</h3>
      </div>
    </div>
    {{/if}}
    {{#each templatesData}}
    <div class="col-6 col-md-4 col-lg-2">
      <div class="templates-card position-relative d-flex justify-content-center align-items-end" style='background-image: url("{{this.thumbnail.url}}");' data-id="{{this.id}}" data-template-name="{{this.templateName}}" data-template-category="{{this.templateCategorySelect}}">
        <p class="w-100 bg-white mb-0 text-center">{{this.templateName}}</p> 
        {{#if @root.adminLoggedIn}} 
          <i class="delete-btn bi bi-trash position-absolute top-0 end-0 mt-2 me-2 border border-danger text-danger rounded-circle d-inline-flex justify-content-center align-items-center" style="width: 30px; height: 30px;"></i> 
        {{/if}}
      </div>
    </div>
    {{/each}}
  </div>
</div>

<!-- Modal -->
<div class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
  aria-labelledby="staticBackdropLabel" aria-hidden="true" id="templateFormModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="staticBackdropLabel">Modal title</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body position-relative">
        <form id="templateForm">
          <div class="mb-3">
            <label for="templateName" class="form-label">Template name</label>
            <input type="text" class="form-control" id="templateName" name="templateName"
              aria-describedby="templateHelp" required>
            <div id="templateHelp" class="form-text">This is the template name shown to all users</div>
          </div>
          <div class="mb-3">
            <label for="formFile" class="form-label">Upload the preview image</label>
            <input class="form-control" type="file" id="formFile" name="formFile"
              accept="image/png, image/jpeg, image/webp" required>
          </div>
          <label for="templateCategorySelect" class="form-label">Select the category of the template</label>
          <select class="form-select mb-3" aria-label="Default select example" id="templateCategorySelect"
            name="templateCategorySelect" required>
            <option value="" selected disabled>Select the template category</option>
            {{#each templateCategories}}
            <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
          </select>
          <div class="mb-3">
            <label for="templateHBS" class="form-label">HBS template</label>
            <textarea class="form-control text-nowrap font-monospace" rows="8" spellcheck="false" id="templateHBS"
              name="templateHBS" aria-describedby="templateHBSHelp" required></textarea>
            <div id="templateHBSHelp" class="form-text">Enter the HBS template here</div>
          </div>
          <div class="mb-3">
            <label for="formFieldInput" class="form-label">select the required fields in required order</label>
            <div class="w-100 formFieldsInput" id="formFieldsInput">
              <div class="" id="form-editor">

              </div>
              <div id="form-renderer">

              </div>
              <div class="w-100 position-relative">
                <div class="w-100" id="fieldsListContainer">
                </div>
              </div>
            </div>
          </div>
          <div class="mb-3">
            <label for="formHBS" class="form-label">Template form</label>
            <textarea class="form-control text-nowrap font-monospace" rows="8" spellcheck="false" id="formHBS"
              name="formHBS" aria-describedby="formHBSHelp"></textarea>
            <div id="formHBSHelp" class="form-text">Enter the HTML form here</div>
          </div>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="exampleCheck1" required>
            <label class="form-check-label" for="exampleCheck1">Check me out</label>
          </div>
          <button type="submit" class="btn btn-primary">Submit</button>
        </form>

      </div>
    </div>
  </div>
</div>



<script>
  $(document).ready(function () {
    const createTemplateBtn = $("#createTemplate")
    const addFieldBtn = $("#addFieldBtn")
    const formFieldInput = $("#formFieldInput")
    const fieldsListContainer = $("#fieldsListContainer")
    const templateForm = $("#templateForm");
    const templatesCard = $(".templates-card");
    const deleteBtn = $(".delete-btn")
    const templateSearch = $("#templateSearch")

    const templateCards = []
    let fieldsOl = ''

    const formModalElement = document.getElementById('templateFormModal');
    const formModal = new bootstrap.Modal(formModalElement);

    let fieldsList = {}

    let nextInstanceId = 0

    createTemplateBtn.click(function () {
      formModal.show();
    })


    const editor = $("#form-editor").formBuilder({
      onSave: function (evt, formData) {
        $('#form-renderer').formRender({ formData });
      }
    });


    templateForm.on("submit", function (e) {
      e.preventDefault();

      if (!this.checkValidity()) {
        this.reportValidity();
        return
      }

      const formData = new FormData();
      const formFields = editor.actions.getData("json")

      if (formFields === '[]' && !$("#formHBS").val().trim()) {
        alert("No form where made.")
        return
      }

      formData.append("templateName", $("#templateName").val());
      formData.append("templateCategorySelect", $("#templateCategorySelect").val());
      formData.append("formFile", $("#formFile")[0].files[0]);
      formData.append("templateHBS", $("#templateHBS").val());
      formData.append("formHBS", $("#formHBS").val().trim() || null);
      formData.append("fieldsData", formFields);

      $.ajax({
        url: "/admin/templates/create",
        method: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
          console.log(response);
          formModal.hide();
          window.location.reload()
        },
        error: function (err) {
          console.error(err);
        }
      })
    })

    templatesCard.on('click', function () {
      const clickedId = $(this).data('id')
      if (!clickedId) return

      window.open(`/templates/${clickedId}`, '_blank')
    })

    deleteBtn.on('click', function (e) {
      e.stopPropagation();

      if (!confirm("Are you sure you want to delete this item?")) return "user denied!";

      const templateId = $(this).closest(".templates-card").data('id');

      $.ajax({
        url: "/admin/delete/template/" + templateId,
        method: 'DELETE',
        success: function (response) {
          console.log('template deleted succuessfully:', response)
          location.reload()
        },
        error: function (response) {
          console.log('template delete failed: ', response)
        }
      })
    })

    $(".templates-card[data-template-name]").each(function () {
      templateCards.push({
        element: this,
        name: $(this).data('template-name'),
        category: $(this).data('template-category')
      })
    })

    const fuse = new Fuse(templateCards, {
      keys: ["name", "category"],
      threshold: 0.4,
      ignoreLocation: true
    })

    templateSearch.on('input', function () {
      const searchTerm = $(this).val().trim()

      if (!searchTerm) {
        templateCards.forEach(template => {
          $(template.element).closest(".col-6").show()
        })
        return
      }

      const result = fuse.search(searchTerm)

      templateCards.forEach(template => {
        $(template.element).closest(".col-6").hide()
      })

      result.forEach(result => {
        $(result.item.element).closest(".col-6").show()
      })
    })
  })
</script>