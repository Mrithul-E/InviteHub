<div class="hero-image container-fluid">
    <div class="row align-items-center">
        <div class="hero-content col-md-6 d-flex align-items-center flex-column">
            <div class="d-flex justify-content-between align-items-center pt-5 gap-2">
                <img src="images/Logo_Transparent_NoBuffer.png" alt="" id="hero-icon">
                <div class="d-flex flex-column text-center" id="logo-text">
                    <h1>INVITEHUB</h1>
                    <h3>SINCE 2026</h3>
                </div>
            </div>
            <div class="hero-details pt-3 text-center">
                <h1>Create <span>Beautiful</span><br>Invitation Pages</h1>
                <h3>Easily design and share invitations<br>for any occasion.</h3>
            </div>
            <div class="hero-button-container pt-4">
                <button class="purple-btn" id="startBtn">Get Started</button>
                <button class="white-btn" id="watchDemoBtn">Watch Demo</button>
            </div>
            <div class="w-100 d-none my-3" id="demoVideoContainer">
                <video src="https://github.com/user-attachments/assets/4d0e232f-aeee-414b-bf0e-31e5e015580c" controls
                    preload="metadata" class="w-100" id="demoVideo">
                </video>
            </div>
        </div>
        <div class="col-md-6 d-none d-sm-none d-md-flex hero-graphics align-items-center justify-content-center">
            <img src="/images/hero_animation_phone.png" alt="">
        </div>
        <div class="col-md-12 mt-5 text-center home-content">
            <h1 class="mb-2">OUR MISSION</h1>
            <p>Our mission is to make digital invitation page easier. By decreasing the use of printed invitations, we can decrease the use of paper which decrease the cutting of trees.</p>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        let initialScrollPosition = 0
        let videoSrc = $("#demoVideo").attr('src')

        $("#startBtn").on('click', function () {
            window.location.href = '/templates'
        })

        $("#watchDemoBtn").on('click', function () {
            $("#demoVideoContainer").toggleClass('d-none')

            if (!$("#demoVideoContainer").hasClass('d-none')) {

                initialScrollPosition = window.screenY

                $("#demoVideoContainer")[0].scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                $("#demoVideo").attr('src', videoSrc)
                $("#demoVideo")[0].play()
                $(this).text("Close Demo")
            } else {
                window.scrollTo({
                    top: initialScrollPosition,
                    behavior: "smooth"
                })

                $("#demoVideo")[0].pause()
                $("#demoVideo")[0].removeAttribute('src')
                $("#demoVideo")[0].load();
                
                $(this).text("Watch Demo")
            }
        })
    })
</script>